# Tomato Animes - Environment Variables
# Copy this file to .env and fill in your values

# Build Configuration
NODE_ENV=development
EAS_BUILD_PROFILE=development

# API Configuration
API_BASE_URL=https://api.tomatoanimes.com/v1
API_TIMEOUT=15000

# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:ios:abcdef123456
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# AppLovin MAX Configuration
APPLOVIN_SDK_KEY=your-applovin-sdk-key

# App Center Configuration
APPCENTER_IOS_SECRET=your-appcenter-ios-secret
APPCENTER_ANDROID_SECRET=your-appcenter-android-secret

# Sentry Configuration (optional)
SENTRY_DSN=your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Google Services (for iOS)
# Place GoogleService-Info.plist in project root

# Google Services (for Android)
# Place google-services.json in project root

# Apple Developer
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_ID=your-apple-id@example.com
ASC_APP_ID=your-app-store-connect-app-id

# Google Play
# Place google-play-service-account.json in project root