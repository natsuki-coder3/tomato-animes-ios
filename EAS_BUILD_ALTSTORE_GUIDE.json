  "quickTestChecklist": [
    { "test": "App launches (Splash → Welcome)", "expected": "No crash, shows onboarding", "category": "launch" },
    { "test": "Tab navigation (Home, Search, Downloads, Profile)", "expected": "Smooth transitions", "category": "navigation" },
    { "test": "Theme toggle (Light/Dark/Glass)", "expected": "Immediate UI update", "category": "ui" },
    { "test": "Settings screen opens", "expected": "All sections render", "category": "ui" },
    { "test": "Profile screen opens", "expected": "Shows mock user data", "category": "ui" },
    { "test": "Search screen opens", "expected": "Keyboard works, history shows", "category": "ui" },
    { "test": "Player screen opens", "expected": "Shows placeholder (not black)", "category": "player", "note": "Mock player — expected" },
    { "test": "Background → Foreground", "expected": "No crash, state preserved", "category": "lifecycle" },
    { "test": "Pull-to-refresh (Home)", "expected": "Spinner shows, no crash", "category": "interaction" },
    { "test": "Orientation lock (Portrait)", "expected": "Stays portrait on rotate", "category": "config" }
  ],
  "quickReferenceCommands": {
    "buildDevelopment": "eas build --platform ios --profile development",
