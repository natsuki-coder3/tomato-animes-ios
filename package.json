{
  "name": "tomato-animes",
  "version": "1.6.1",
  "description": "Tomato Animes - iOS App with Liquid Glass Design",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform ios",
    "build:production": "eas build --profile production --platform ios",
    "build:all": "eas build --profile production --platform all",
    "submit:ios": "eas submit --platform ios",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "14.0.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/analytics": "20.4.0",
    "@react-native-firebase/app": "20.4.0",
    "@react-native-firebase/crashlytics": "20.4.0",
    "@react-native-firebase/messaging": "20.4.0",
    "@react-native-firebase/remote-config": "20.4.0",
    "@shopify/react-native-skia": "0.1.200",
    "@tanstack/react-query": "5.28.0",
    "ajv": "^8.20.0",
    "expo": "51.0.0",
    "expo-application": "~5.9.1",
    "expo-av": "~14.0.7",
    "expo-blur": "~12.0.1",
    "expo-build-properties": "~0.12.5",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-device": "~6.0.2",
    "expo-document-picker": "~12.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image": "2.0.0",
    "expo-image-picker": "~15.1.0",
    "expo-intent-launcher": "~11.0.1",
    "expo-linking": "~6.3.1",
    "expo-localization": "~15.0.3",
    "expo-media-library": "~16.0.5",
    "expo-notifications": "~0.28.19",
    "expo-random": "~14.0.1",
    "expo-router": "3.5.0",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "expo-task-manager": "~11.8.2",
    "expo-web-browser": "~13.0.3",
    "liquid-glass-design-system": "file:./src/components/glass",
    "lottie-react-native": "6.3.1",
    "nativewind": "4.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "2.16.0",
    "react-native-get-random-values": "1.11.0",
    "react-native-mmkv": "4.3.2",
    "react-native-reanimated": "3.10.0",
    "react-native-safe-area-context": "4.10.0",
    "react-native-screens": "3.31.0",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-webview": "13.8.0",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0",
    "@expo/metro-config": "^0.18.0",
    "@react-native/babel-preset": "^0.74.0",
    "@react-native/eslint-config": "^0.74.0",
    "@react-native/metro-config": "^0.88.1",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^11.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "^51.0.0",
    "metro-react-native-babel-preset": "^0.74.0",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.0",
    "react-native-svg-transformer": "^1.5.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0"
  },
  "private": true,
  "expo": {
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-notifications",
      "expo-media-library",
      "expo-document-picker",
      "expo-image-picker",
      "expo-av",
      "expo-dev-client",
      "expo-task-manager",
      "expo-file-system",
      "expo-localization",
      "expo-splash-screen",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24,
            "ndkVersion": "25.2.9519653",
            "extraMavenRepos": [
              "https://repo.maven.apache.org/maven2/"
            ]
          }
        }
      ],
      [
        "./src/components/glass/native/expo-plugin.js",
        {
          "moduleName": "LiquidGlass",
          "swiftVersion": "5.9"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist"
          }
        }
      ],
      [
        "expo-av",
        {
          "audioMode": "Playback",
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "newArchitectureEnabled": true,
      "typedRoutes": true
    }
  },
  "react-native": {
    "nativeModules": {
      "GlassEffectView": "src/components/glass/native/GlassEffectViewManager.m",
      "TomatoSignModule": "src/native/ios/TomatoSignModule.swift",
      "TobEncryptModule": "src/native/ios/TobEncryptModule.swift",
      "UnityPlayerModule": "src/native/ios/UnityPlayerModule.swift",
      "NativeFiltersModule": "src/native/ios/NativeFiltersModule.swift",
      "FFmpegModule": "src/native/ios/FFmpegModule.swift",
      "NMSModule": "src/native/ios/NMSModule.swift",
      "DataStoreCounterModule": "src/native/ios/DataStoreCounterModule.swift"
    }
  }
}
